rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Product Enquiries rules
    match /productEnquiries/{document} {
      allow create: if true; // Seekers can submit orders
      allow read, update, delete: if request.auth != null; // Only authenticated admins can read/manage
    }

    // Volunteers rules
    match /volunteers/{document} {
      allow create: if true; // Seekers can apply to volunteer
      allow read, update, delete: if request.auth != null; // Only authenticated admins can read/manage
    }

    // Yatra Registrations rules
    match /yatraRegistrations/{document} {
      allow create: if true; // Seekers can register
      allow read, update, delete: if request.auth != null; // Only authenticated admins can read/manage
    }
  }
}
